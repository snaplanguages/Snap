{
  "html_body": "<div class=\"bg-watermark\">SnapEnglish</div>\n<div id=\"setupModal\" class=\"modal-overlay show\">\n<div class=\"modal-box\">\n<div class=\"modal-title\" id=\"setupModalTitle\">Đang tải đề thi...</div>\n<div class=\"modal-desc\" id=\"setupModalDesc\">Đang tải thông tin đề thi...</div>\n<button class=\"mode-btn\" id=\"btnModePractice\" onclick=\"selectMode('practice')\">🌿 Luyện Tập </button>\n<button class=\"mode-btn\" id=\"btnModeMock\" onclick=\"selectMode('mock')\">🔥 Thi Thử </button>\n<div id=\"timeSettings\" style=\"display: none; margin-top: 15px;\">\n<label style=\"font-weight: 700; color: var(--text-main);\">Thời gian (phút): </label>\n<input type=\"number\" id=\"inputTime\" class=\"input-time\" value=\"45\" min=\"5\" max=\"120\">\n</div>\n<div style=\"display: flex; gap: 10px; margin-top: 15px;\">\n<button class=\"btn btn-outline\" style=\"flex: 1;\" onclick=\"openHistoryModal()\">🕒 Xem lịch sử</button>\n<button class=\"btn btn-primary\" style=\"flex: 1; display: none;\" id=\"btnStart\" onclick=\"startTest()\">Bắt đầu</button>\n</div>\n</div>\n</div>\n<div id=\"historyOverlay\" class=\"modal-overlay\">\n<div class=\"modal-box\">\n<div class=\"modal-title\">🕒 Lịch sử làm bài</div>\n<div id=\"historyList\"></div>\n<button class=\"btn btn-outline\" style=\"width: 100%;\" onclick=\"closeModal('historyOverlay')\">Quay lại</button>\n</div>\n</div>\n<div id=\"confirmModal\" class=\"modal-overlay\">\n<div class=\"modal-box\">\n<div class=\"modal-title\">Xác nhận nộp bài</div>\n<div class=\"modal-desc\">Bạn có chắc chắn muốn nộp bài? Các câu chưa làm sẽ bị tính là sai.</div>\n<div class=\"modal-actions\">\n<button class=\"btn btn-outline\" onclick=\"closeModal('confirmModal')\">Quay lại làm tiếp</button>\n<button class=\"btn btn-primary\" onclick=\"executeSubmit()\">Đồng ý nộp bài</button>\n</div>\n</div>\n</div>\n<div id=\"customConfirmModal\" class=\"modal-overlay\">\n<div class=\"modal-box\">\n<div class=\"modal-title\" id=\"ccTitle\">Xác nhận</div>\n<div class=\"modal-desc\" id=\"ccDesc\">Bạn có chắc chắn muốn thực hiện hành động này?</div>\n<div class=\"modal-actions\">\n<button class=\"btn btn-outline\" onclick=\"closeModal('customConfirmModal')\">Hủy bỏ</button>\n<button class=\"btn btn-danger\" id=\"ccConfirmBtn\">Đồng ý</button>\n</div>\n</div>\n</div>\n<div id=\"resultModal\" class=\"modal-overlay\">\n<div class=\"modal-box\">\n<div class=\"modal-title\">Kết Quả Bài Thi 🏆</div>\n<div style=\"font-size: 60px; font-weight: 800; color: var(--primary); margin: 10px 0;\" id=\"scoreDisplay\">0/100</div>\n<div class=\"modal-desc\" id=\"scoreComment\">Tuyệt vời! Hãy xem chi tiết giải thích ở từng câu bên dưới.</div>\n<div class=\"modal-actions\">\n<button class=\"btn btn-outline\" onclick=\"location.reload()\">Làm lại bài khác</button>\n<button class=\"btn btn-success\" onclick=\"closeModal('resultModal')\">Xem giải thích chi tiết</button>\n</div>\n</div>\n</div>\n<header>\n<a href=\"index.html\" class=\"brand\" title=\"Về trang chủ SnapEnglish\">\n<div class=\"brand-badge\">SnapEnglish</div>\n<div class=\"brand-subtitle\">Listening Test</div>\n</a>\n<div class=\"tabs\">\n<button class=\"tab-btn active\" onclick=\"switchTab(1)\">Part 1</button>\n<button class=\"tab-btn\" onclick=\"switchTab(2)\">Part 2</button>\n<button class=\"tab-btn\" onclick=\"switchTab(3)\">Part 3</button>\n<button class=\"tab-btn\" onclick=\"switchTab(4)\">Part 4</button>\n</div>\n<!-- Đồng hồ & Nút nộp bài -->\n<div class=\"header-right\">\n<div class=\"timer\" id=\"timer\">45:00</div>\n<button class=\"btn btn-primary\" id=\"headerSubmitBtn\" onclick=\"requestSubmit()\">Nộp bài</button>\n</div>\n</header>\n<main id=\"mainContent\"></main>\n<div class=\"card-navigation\" id=\"cardNavArea\" style=\"padding: 10px 40px 20px 40px; margin-top: 10px;\">\n<button class=\"btn-nav\" id=\"btnPrevCard\" onclick=\"prevCard()\">⬅ Câu trước</button>\n<button class=\"btn-nav\" id=\"btnNextCard\" onclick=\"nextCard()\">Câu tiếp theo ➡</button>\n</div>\n<button class=\"nav-toggle-btn\" id=\"navToggleBtn\" onclick=\"toggleNavPanel()\">\n🧭 <span id=\"answeredCount\">0</span>/100\n</button>\n<div class=\"nav-overlay\" id=\"navOverlay\" onclick=\"toggleNavPanel()\"></div>\n<div id=\"navPanel\" class=\"nav-panel\">\n<div class=\"nav-panel-header\">\n<div class=\"nav-title\" style=\"margin: 0; font-size: 18px;\">Bảng điều hướng nhanh</div>\n<button class=\"close-nav-btn\" onclick=\"toggleNavPanel()\">✖</button>\n</div>\n<div class=\"nav-grid\" id=\"navGrid\"></div>\n</div>"
}